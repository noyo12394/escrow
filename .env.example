# S.T.A.R. Earthquake Rescue Lab - environment variables
# Copy to ".env" for local dev, and set the same keys in your Vercel project
# (Settings -> Environment Variables). All are optional: without them the game
# runs in local-only mode and activity is not recorded.

# Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# Supabase public anon key (safe to expose in the browser with RLS enabled)
VITE_SUPABASE_ANON_KEY=
